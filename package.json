		"@langchain/tavily": "^1.2.0",
		"boxen": "^5.1.2",
		"chalk": "^4.1.2",
		"commander": "^15.0.0",
		"dotenv": "^17.4.2",
		"figlet": "^1.11.3",
		"langchain": "^1.5.3",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
