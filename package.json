{
	"name": "termclaw",
	"version": "1.0.0",
	"description": "A personal AI Agent like OpenClaw, including tools, skills, memory, hook, sub-agent, MCP sever, etc. Run in the terminal.",
	"main": "dist/index.js",
	"bin": {
		"termclaw": "dist/agent/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		".env.example"
	],
	"scripts": {
		"build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-skills.mjs",
		"dev": "ts-node src/agent/cli.ts",
		"start": "node dist/agent/cli.js",
		"typecheck": "tsc --noEmit",
		"test": "jest",
		"test:watch": "jest --watch"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/qlypupil/mini-agent.git"
	},
