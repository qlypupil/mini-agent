	"bugs": {
		"url": "https://github.com/qlypupil/mini-agent/issues"
	},
	"homepage": "https://github.com/qlypupil/mini-agent#readme",
	"devDependencies": {
		"@types/figlet": "^1.7.0",
		"@types/jest": "^30.0.0",
		"jest": "^30.0.5",
		"ts-jest": "^29.4.1",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@11.7.0",
