# Optional. Default model provider: kimi. Available values: kimi, deepseek.
MODEL_PROVIDER=kimi

# Moonshot (Kimi) API key. Required when kimi is selected.
MOONSHOT_API_KEY=

# Optional. Defaults to https://api.moonshot.cn/v1.
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# Optional. Defaults to kimi-k2.6. Unknown models display an unknown context limit.
MOONSHOT_MODEL=kimi-k2.6

# DeepSeek API key. Required when deepseek is selected.
DEEPSEEK_API_KEY=

# Optional. Defaults to https://api.deepseek.com.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional. Defaults to deepseek-v4-flash.
DEEPSEEK_MODEL=deepseek-v4-flash

# Tavily API key. Required to use the Tavily API.
TAVILY_API_KEY=
